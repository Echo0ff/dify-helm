# ===========================================
# 敏感信息配置文件模板
# 使用说明：
# 1. 复制此文件为 values-secrets.yaml
# 2. 填入实际的敏感信息
# 3. values-secrets.yaml 已在 .gitignore 中，不会被提交
# 4. 部署示例：
#      helm template dify ./charts/dify \
#        -f values-dify.yaml \
#        -f values-dify-prod.yaml \
#        -f values-secrets.yaml
# ===========================================
# 注意：本文件键名严格对应 charts/dify/values.yaml 中的字段，
#       不要使用顶层的 postgres / redis / oss / milvus 等简写，
#       否则 chart 不会读取，渲染结果会用默认空值！
# ===========================================

###################################
# Dify 应用密钥
# - global.appSecretKey 用于签名 session cookie、加密敏感字段
# - 用 `openssl rand -base64 42` 生成
###################################
global:
  appSecretKey: "YOUR_APP_SECRET_KEY"
  # 组件间互调用的统一 API Key，留空则各组件单独配置
  internalApiKey: ""

###################################
# Sandbox（代码执行沙箱）
# - sandbox.auth.apiKey 用于 API → Sandbox 的鉴权
# - 留空时 fallback 到 global.internalApiKey
###################################
sandbox:
  auth:
    apiKey: "YOUR_SANDBOX_API_KEY"

###################################
# Plugin Daemon 鉴权
# - serverKey      : plugin-daemon 服务自身的访问密钥
# - difyApiKey     : Dify API → plugin-daemon 的内部互调用密钥
# - 均用 `openssl rand -base64 42` 生成；留空 fallback 到 global.internalApiKey
###################################
pluginDaemon:
  auth:
    serverKey: "YOUR_SERVER_KEY"
    difyApiKey: "YOUR_DIFY_API_KEY"

###################################
# 邮件配置（位于 api.mail，不是顶层 mail）
# - type: smtp 或 resend
###################################
api:
  mail:
    defaultSender: "Dify Notification <no-reply@example.com>"
    type: "smtp"
    # SMTP（type=smtp 时使用）
    smtp:
      server: "smtp.qq.com"
      port: 465                       # 465 = SSL；587 = STARTTLS
      username: "your_mail@example.com"
      password: "YOUR_EMAIL_PASSWORD"  # 邮箱密码或授权码
      tls:
        enabled: true
        optimistic: false              # false = 强制 TLS；true = STARTTLS
    # Resend（type=resend 时使用）
    resend:
      apiKey: "YOUR_RESEND_API_KEY"
      apiUrl: "https://api.resend.com"

###################################
# 外部 PostgreSQL（启用后会禁用内置 postgresql 子 chart）
# - 字段是 address（不是 host）
###################################
externalPostgres:
  enabled: true
  username: "postgres"
  password: "YOUR_POSTGRES_PASSWORD"
  address: "your-postgres-host"
  port: 5432
  database:
    api: "dify"
    pluginDaemon: "dify_plugin"

###################################
# 外部 Redis（启用后会禁用内置 redis 子 chart）
###################################
externalRedis:
  enabled: true
  host: "your-redis-host"
  port: 6379
  username: ""                         # Redis 6+ ACL 用户名；无则留空
  password: "YOUR_REDIS_PASSWORD"
  useSSL: false
  db:
    app: 0
    celery: 1
  sentinel:
    enabled: false

###################################
# 外部对象存储 —— 二选一（S3 兼容 / 阿里云 OSS）
# 同一时间只能开启一个
###################################

# === A. S3（含 AWS S3、MinIO、R2 等 S3 兼容服务）===
externalS3:
  enabled: true                         # ⚠️ S3 与 OSS 互斥
  endpoint: "https://s3.us-east-2.amazonaws.com"
  region: "us-east-2"
  accessKey: "YOUR_AWS_ACCESS_KEY"
  secretKey: "YOUR_AWS_SECRET_KEY"
  bucketName:
    api: "ai-dify"
    pluginDaemon: "ai-dify"             # 可与 api 同桶
  pathStyle: false                      # AWS S3=false；MinIO 必须 true
  useIAM: false                         # EKS IRSA / Pod Identity 时设 true

# === B. 阿里云 OSS ===
externalOSS:
  enabled: false                        # 启用 S3 时必须为 false
  endpoint: "https://oss-cn-hangzhou.aliyuncs.com"
  accessKey: "YOUR_OSS_ACCESS_KEY"
  secretKey: "YOUR_OSS_SECRET_KEY"
  region: "cn-hangzhou"
  bucketName:
    api: "your-bucket-name"
    pluginDaemon: "your-bucket-name"
  authVersion: "v4"
  path: ""

###################################
# 向量数据库 —— 多选一
# 同一时间只能启用一个 externalXxx，且与内置 weaviate 互斥
###################################

# === Qdrant ===
externalQdrant:
  enabled: true
  endpoint: "https://your-qdrant-url.qdrant.tech/"
  apiKey: "YOUR_QDRANT_API_KEY"
  timeout: 20
  grpc:
    enabled: false
    port: 6334

# === Milvus（与 Qdrant 互斥，启用其一即可）===
externalMilvus:
  enabled: false
  uri: "http://your-milvus-host:19530"   # 是合并好的 URI，不是 host/port 分开
  database: "default"
  token: ""
  user: "root"
  password: "YOUR_MILVUS_PASSWORD"

# === Weaviate（外部）===
externalWeaviate:
  enabled: false
  endpoint:
    http: "http://weaviate:8080"
    grpc: "grpc://weaviate:50051"
  apiKey: "YOUR_WEAVIATE_API_KEY"

# === Pgvector ===
externalPgvector:
  enabled: false
  username: "postgres"
  password: "YOUR_PGVECTOR_PASSWORD"
  address: "pgvector-host"
  port: 5432
  dbName: "dify"

###################################
# 内置 PostgreSQL（如果启用 bitnami 子 chart，即 externalPostgres.enabled=false）
# 字段路径对应 bitnami/postgresql 子 chart
###################################
postgresql:
  enabled: false
  global:
    postgresql:
      auth:
        postgresPassword: "YOUR_POSTGRES_PASSWORD"
        replicationPassword: "YOUR_REPLICATION_PASSWORD"

###################################
# 内置 Redis（如果启用 bitnami 子 chart，即 externalRedis.enabled=false）
# 字段路径对应 bitnami/redis 子 chart
###################################
redis:
  enabled: false
  auth:
    password: "YOUR_REDIS_PASSWORD"
